# App
NEXT_PUBLIC_APP_NAME=LogiFlow
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-32-byte-random-secret

# PostgreSQL (Neon / Supabase / local docker)
DATABASE_URL=postgresql://logiflow:logiflow@localhost:5432/logiflow?schema=public
DIRECT_URL=postgresql://logiflow:logiflow@localhost:5432/logiflow?schema=public

# Redis / Upstash. Optional in local demo; the app falls back to safe no-op in-memory behavior.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email
RESEND_API_KEY=
EMAIL_FROM=LogiFlow <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Twilio / WhatsApp placeholders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Security / API
API_KEY_PEPPER=replace-with-a-long-random-secret
CRON_SECRET=replace-with-another-long-random-secret
